# DataForge AI - Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
SECRET_KEY=dataforge-secret-key-change-in-production

# Database
POSTGRES_DB=dataforge
POSTGRES_USER=dataforge
POSTGRES_PASSWORD=dataforge
DATABASE_URL=postgresql+asyncpg://dataforge:dataforge@localhost:5432/dataforge
DATABASE_SYNC_URL=postgresql://dataforge:dataforge@localhost:5432/dataforge

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_URL=redis://localhost:6379/1
REDIS_CACHE_URL=redis://localhost:6379/2

# API
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# LLM
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-openai-api-key
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# CAPTCHA
CAPTCHA_AUTO_SOLVE=false
CAPTCHA_SERVICE_API_KEY=

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/storage

# Scraper
BROWSER_HEADLESS=true
MAX_CONCURRENT_BROWSERS=10
PROXY_POOL_SIZE=50
